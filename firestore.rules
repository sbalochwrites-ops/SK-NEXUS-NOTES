rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNote(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 50000 &&
             data.category is string && data.category.size() <= 50 &&
             (!('tags' in data) || (data.tags is string && data.tags.size() <= 500)) &&
             data.isPinned is bool &&
             data.userId is string && data.userId.size() <= 128;
    }

    match /users/{userId}/notes/{noteId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidId(noteId) &&
                       incoming().keys().hasAll(['title', 'content', 'category', 'isPinned', 'userId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'content', 'category', 'tags', 'isPinned', 'userId', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidNote(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidNote(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'tags', 'isPinned', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
